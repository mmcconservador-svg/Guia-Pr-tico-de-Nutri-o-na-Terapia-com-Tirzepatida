{
  "name": "Guia Tirzepatida (dev)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "remoteUser": "node",
  "containerUser": "node",
  "runArgs": ["--cap-drop=ALL", "--security-opt=no-new-privileges"],
  "forwardPorts": [5173],
  "portsAttributes": { "5173": { "label": "Servidor local", "onAutoForward": "notify" } },
  "containerEnv": { "HOST": "0.0.0.0", "PORT": "5173", "NODE_ENV": "development" },
  "postCreateCommand": "cp -n .env.example .env && npm ci --ignore-scripts || npm install --ignore-scripts",
  "postStartCommand": "npm run check && npm run build:web",
  "customizations": {
    "vscode": {
      "extensions": ["editorconfig.editorconfig", "dbaeumer.vscode-eslint", "ms-playwright.playwright"],
      "settings": { "files.eol": "\n", "editor.formatOnSave": false }
    }
  }
}
