# Copie para .env e ajuste. O arquivo .env não é versionado.

# Servidor local de desenvolvimento (npm run serve)
HOST=127.0.0.1
PORT=5173

# Pasta de saída do build (padrão: dist)
BUILD_DIR=dist

# Link do Painel Tirzepatida publicado. Se definido, as ferramentas individuais
# mostram no rodapé um atalho para o painel. Precisa ser https.
HUB_URL=
